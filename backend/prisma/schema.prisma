datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  owner
  admin
  manager
  sales
  marketing
  customer_success
  support
  analyst
  viewer
  ai_operator
}

enum SchoolType {
  public
  private
  cbse
  icse
  state_board
  international
  other
}

enum LeadStatus {
  new
  contacted
  engaged
  qualified
  meeting_scheduled
  proposal_sent
  negotiating
  won
  lost
  disqualified
}

enum AgentType {
  discovery
  website_research
  lead_intelligence
  contact_intelligence
  lead_scoring
  email_personalization
  follow_up
  sales_strategy
  customer_success
  churn_prediction
  upsell
  renewal
  market_intelligence
  competitor_intelligence
  sales_coach
  executive_intelligence
}

enum TaskStatus {
  queued
  running
  completed
  failed
  cancelled
  awaiting_approval
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]
  schools   School[]
  contacts  Contact[]
  leads     Lead[]
  agents    AIAgent[]
  tasks     AITask[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  email          String       @unique
  name           String
  avatarUrl      String?      @map("avatar_url")
  role           Role         @default(sales)
  passwordHash   String       @map("password_hash")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedLeads  Lead[]

  @@map("users")
}

model School {
  id               String      @id @default(uuid())
  organizationId   String      @map("organization_id")
  name             String
  type             SchoolType  @default(cbse)
  address          String?
  city             String?
  state            String?
  country          String      @default("India")
  website          String?
  phone            String?
  email            String?
  studentCount     Int?        @map("student_count")
  principalName    String?     @map("principal_name")
  source           String      @default("open_street_map")
  confidence       Float       @default(0.95)
  websiteData      Json?       @map("website_data")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts         Contact[]
  leads            Lead[]

  @@map("schools")
}

model Contact {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  schoolId       String       @map("school_id")
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  email          String?
  phone          String?
  whatsapp       String?
  designation    String       @default("Principal")
  linkedinUrl    String?      @map("linkedin_url")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  leads          Lead[]

  @@map("contacts")
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  schoolId       String       @map("school_id")
  contactId      String?      @map("contact_id")
  assignedTo     String?      @map("assigned_to")
  status         LeadStatus   @default(new)
  leadScore      Int          @default(50) @map("lead_score")
  scoreBreakdown Json?        @map("score_breakdown")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id])
  assignee       User?        @relation(fields: [assignedTo], references: [id])

  @@map("leads")
}

model AIAgent {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  type           AgentType
  status         String       @default("active")
  model          String       @default("gemini-1.5-flash")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          AITask[]

  @@map("ai_agents")
}

model AITask {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  agentId        String       @map("agent_id")
  type           String
  status         TaskStatus   @default(queued)
  input          Json?
  output         Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent          AIAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("ai_tasks")
}
