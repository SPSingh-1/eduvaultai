# ============================================================
# EDUVAULT AI BACKEND — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================

# App Configuration
NODE_ENV=production
PORT=10000
FRONTEND_URL=https://eduvault-ai-frontend.onrender.com

# AI Providers
GOOGLE_AI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Database (Supabase PostgreSQL with connection pooling)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Cache & Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token
UPSTASH_REDIS_URL=rediss://default:your_redis_token@your-redis.upstash.io:6379

# Email Outreach (Brevo) & Inbound Gmail Sync
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=connectwitheduvault@gmail.com
EMAIL_FROM_NAME=Eduvault AI
GMAIL_USER=your_gmail_for_inbound_replies@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Search & Intelligence
SERPER_API_KEY=your_serper_api_key

# Error Monitoring (Sentry)
SENTRY_DSN_BACKEND=your_sentry_dsn_backend

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_min_64_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_64_characters
JWT_REFRESH_EXPIRES_IN=7d
